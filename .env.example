# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYMENT METHOD CONFIGURATION
# MemoPrint operates strictly on Cash on Delivery (COD) across India.
# No online payment gateway credentials (Razorpay, Stripe, etc.) are required or used.
PAYMENT_METHOD="cod"

# SESSION_SECRET: REQUIRED in production (at least 24 characters). The server refuses to
# start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# SITE_URL: your public address, used for share-preview links (no trailing slash).
SITE_URL="https://your-domain.example"

# Optional tuning
# TRUST_PROXY_HOPS=1
# MEDIA_CACHE_MAX_MB=128
# ORDER_WRITE_TIMEOUT_MS=12000

# Admin mode (see README): needed for one-time coupons, shared limits and 10 MB photos.
# On Google Cloud the server's own identity is used and this can stay empty.
# Elsewhere paste the whole service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Free image storage (optional): Cloudflare R2 gives 10 GB free with free downloads. When these four are set,
# photos can be up to 10 MB and are kept in your private bucket instead of inside Firestore documents.
# Create a bucket in Cloudflare > R2, then an API token with "Object Read & Write" for that bucket.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# R2_ENDPOINT=""   # only for other S3-compatible services (Backblaze B2, MinIO...)

# How long the shared product catalogue is cached on the server (seconds). Default 300.
# CATALOG_CACHE_SECONDS=300
